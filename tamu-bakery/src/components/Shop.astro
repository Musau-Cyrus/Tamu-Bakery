---
// src/components/Shop.astro
// "Shop by occasion" tiles, filter chips and the product grid, all on the home page.
// Tiles, chips, the header's Shop menu and the mobile menu all filter the same grid.
// Products appear in the order of the "order" number in each JSON file.

import CategoryTile from "./CategoryTile.astro";
import Chip from "./Chip.astro";
import ProductCard from "./ProductCard.astro";
import { getProducts, CATEGORIES } from "../lib/products";

const products = await getProducts();

const tileIds = ["birthday", "bridal", "cupcakes", "pastries"];
const tiles = CATEGORIES.filter((c) => tileIds.includes(c.id)).map((c) => ({
  ...c,
  image: products.find((p) => p.data.category === c.id)?.data.image,
}));

const labels = Object.fromEntries([["all", "All treats"], ...CATEGORIES.map((c) => [c.id, c.label])]);
---

<section id="shop" class="px-4 pb-16 lg:px-10 lg:pb-24" aria-labelledby="occasion-heading">
  <div class="mx-auto max-w-[1160px]">
    <h2 id="occasion-heading" class="text-[30px] lg:text-[40px]">Shop by occasion</h2>
    <p class="mt-2 max-w-[44ch] text-sm text-muted lg:text-base">
      Pick a category, choose your size and flavour, and we bake it fresh for your date.
    </p>

    <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4 lg:gap-6">
      {tiles.map((t) => <CategoryTile filter={t.id} label={t.label} tint={t.tint} image={t.image} />)}
    </div>

    <div id="products" class="mt-16 flex flex-wrap items-end justify-between gap-4">
      <h2 id="list-title" class="text-[30px] lg:text-[40px]" data-labels={JSON.stringify(labels)}>All treats</h2>
      <!-- On phones the chips scroll sideways instead of wrapping -->
      <div id="chips" class="-mx-4 flex w-[calc(100%+2rem)] gap-2 overflow-x-auto px-4 pb-1 lg:mx-0 lg:w-auto lg:px-0" role="group" aria-label="Filter products">
        <Chip data-filter="all" aria-pressed="true">All</Chip>
        {CATEGORIES.map((c) => <Chip data-filter={c.id} aria-pressed="false">{c.short}</Chip>)}
      </div>
    </div>

    <div id="product-grid" class="mt-8 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-3 lg:grid-cols-4 lg:gap-x-6">
      {products.map((p) => <ProductCard product={p} />)}
    </div>
  </div>
</section>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-product-card]"));
  const chips = Array.from(document.querySelectorAll<HTMLElement>("#chips [data-filter]"));
  const title = document.querySelector<HTMLElement>("#list-title")!;
  const labels: Record<string, string> = JSON.parse(title.dataset.labels || "{}");

  function applyFilter(id: string) {
    cards.forEach((card) => {
      card.hidden = !(id === "all" || card.dataset.category === id);
    });
    chips.forEach((chip) => chip.setAttribute("aria-pressed", String(chip.dataset.filter === id)));
    title.textContent = labels[id] || "All treats";
  }

  // Any element with data-filter (tiles, chips, header menus) filters the grid.
  document.addEventListener("click", (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>("[data-filter]");
    if (!trigger) return;
    if (trigger.tagName === "A") e.preventDefault();
    applyFilter(trigger.dataset.filter!);
    // Chips sit right above the grid already, so only the other triggers scroll
    if (!trigger.closest("#chips")) {
      document.getElementById("products")?.scrollIntoView({ behavior: "smooth" });
    }
  });
</script>