---
// src/components/Footer.astro
// Deep rose footer: about + M-Pesa badge, visit details, social links, legal bar.

const year = new Date().getFullYear();
const whatsapp = "https://wa.me/" + import.meta.env.PUBLIC_WHATSAPP_NUMBER;

// Replace these with the bakery's real details and social pages.
const address = "Your street address, your town";
const hours = [
  "Mon to Sat 7am to 7pm",
  "Sun 9am to 4pm",
];
const social = [
  { label: "WhatsApp", href: whatsapp },
  { label: "Instagram", href: "https://instagram.com/" },
  { label: "TikTok", href: "https://tiktok.com/" },
  { label: "Facebook", href: "https://facebook.com/" },
];
const shop = [
  { label: "Birthday cakes", href: "/shop/birthday" },
  { label: "Bridal cakes", href: "/shop/bridal" },
  { label: "Cupcakes", href: "/shop/cupcakes" },
  { label: "Pastries and bread", href: "/shop/pastries" },
];
const legal = [
  { label: "Privacy", href: "/privacy" },
  { label: "Terms", href: "/terms" },
  { label: "Refunds and cancellations", href: "/refunds" },
];
---

<footer class="bg-deep text-white">
  <div class="mx-auto grid max-w-[1160px] gap-10 px-4 py-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:px-10">
    <!-- About -->
    <div>
      <p class="font-serif text-2xl font-semibold">Tamu Bakery</p>
      <p class="mt-2 max-w-xs text-sm leading-relaxed text-white/85">
        Cakes and bakes made fresh in Kenya. "Tamu" means sweet.
      </p>
      <span class="mt-4 inline-flex items-center gap-2 rounded-full bg-white/15 px-3.5 py-1.5 text-[13px] font-medium">
        <span class="h-[9px] w-[9px] rounded-full bg-mpesa"></span>
        Pay with M-Pesa
      </span>
    </div>

    <!-- Shop -->
    <nav aria-label="Shop">
      <h2 class="font-serif text-lg font-semibold">Shop</h2>
      <ul class="mt-3 grid gap-1.5 text-sm">
        {
          shop.map((l) => (
            <li>
              <a href={l.href} class="text-white/85 hover:text-white hover:underline">{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Visit -->
    <div>
      <h2 class="font-serif text-lg font-semibold">Visit</h2>
      <address class="mt-3 grid gap-1.5 text-sm not-italic text-white/85">
        <span>{address}</span>
        {hours.map((h) => <span>{h}</span>)}
      </address>
    </div>

    <!-- Follow and chat -->
    <nav aria-label="Social">
      <h2 class="font-serif text-lg font-semibold">Follow and chat</h2>
      <ul class="mt-3 grid gap-1.5 text-sm">
        {
          social.map((l) => (
            <li>
              <a
                href={l.href}
                target="_blank"
                rel="noopener"
                class="text-white/85 hover:text-white hover:underline"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- Legal bar (extra bottom space on phones so the floating WhatsApp button never covers it) -->
  <div class="border-t border-white/15">
    <div class="mx-auto flex max-w-[1160px] flex-col gap-3 px-4 pb-24 pt-5 text-xs text-white/75 md:flex-row md:items-center md:justify-between md:pb-5 lg:px-10">
      <p>&copy; {year} Tamu Bakery. All rights reserved.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-1">
        {
          legal.map((l) => (
            <li>
              <a href={l.href} class="hover:text-white hover:underline">{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
