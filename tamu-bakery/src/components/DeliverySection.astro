---
// src/components/DeliverySection.astro
// Delivery fees, pickup details and how much notice each kind of order needs.
// The numbers come from src/lib/delivery.ts, so you only edit them in one place.

import { ZONES, SLOTS, NOTICE, PICKUP } from "../lib/delivery";
import { kes } from "../lib/format";
---

<section id="delivery" class="px-4 py-14 lg:px-10 lg:py-20" aria-labelledby="delivery-heading">
  <div class="mx-auto max-w-[1160px]">
    <h2 id="delivery-heading" class="text-[30px] lg:text-[40px]">Delivery and pickup</h2>

    <div class="mt-8 grid gap-10 md:grid-cols-3 md:gap-10">
      <div>
        <h3 class="text-xl">Delivery fees</h3>
        <ul class="mt-4 grid gap-3 text-sm">
          {
            ZONES.map((z) => (
              <li class="flex justify-between gap-4 border-b border-line pb-3">
                <span>{z.name}</span>
                <span class="whitespace-nowrap font-medium">{kes(z.fee)}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-5 text-sm font-medium">Delivery time slots</p>
        <ul class="mt-2 grid gap-1 text-sm text-muted">
          {SLOTS.map((s) => <li>{s}</li>)}
        </ul>
      </div>

      <div>
        <h3 class="text-xl">Pickup</h3>
        <p class="mt-4 text-sm text-muted">Collect from our shop at <strong class="text-ink">{PICKUP.address}</strong>.</p>
        <ul class="mt-3 grid gap-1 text-sm text-muted">
          {PICKUP.hours.map((h) => <li>{h}</li>)}
        </ul>
      </div>

      <div>
        <h3 class="text-xl">How much notice we need</h3>
        <ul class="mt-4 grid gap-3 text-sm">
          {
            NOTICE.map((n) => (
              <li class="flex justify-between gap-4 border-b border-line pb-3">
                <span>{n.label}</span>
                <span class="whitespace-nowrap font-medium">{n.time}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
