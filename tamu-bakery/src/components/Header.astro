---
import "../styles/global.css";

interface Props {
  cartCount?: number;
}

const { cartCount = 2 } = Astro.props;

const navLinks = [
  { label: "Shop", href: "/shop" },
  { label: "Custom cakes", href: "/custom-cakes" },
  { label: "Delivery and pickup", href: "/delivery" },
];
---

<header class="w-full">
  <!--Top Announcement bar -->
  <aside class="bg-deep text-white px-4 py-2 text-sm font-light">
    <div
      class="max-w-5xl mx-auto flex items-center justify-center gap-2 text-center"
    >
      <p>Pay with Mpesa. Delivery across Nairobi or pick up from our shop</p>
    </div>
  </aside>

  <!-- Main Navigation Bar -->
  <div class="bg-bg border-b border-line">
    <div
      class="max-w-5xl mx-auto px-4 sm:px-4 h-16 py-3 flex items-center justify-between"
    >
      <!-- Company Logo -->
      <a href="/" class="flex items-baseline gap-1.5 text-ink group">
        <span
          class="font-serif text-2xl md:text-2xl font-semibold tracking-tight"
          >Tamu</span
        >
        <span class="font-sans text-sm text-muted font-normal">Bakery</span>
      </a>

      <!-- Desktop Nav -->
      <nav
        class="hidden md:flex items-center gap-8 text-muted text-sm font-normal"
      >
        {
          navLinks.map((link) => (
            <a href={link.href} class="hover:text-ink transition-colors">
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Right controls: Cart and Hamburger -->
      <div class="flex items-center gap-2.5">
        <!-- Cart Pill -->
        <a
          href="/cart"
          class="flex items-center gap-1.5 px-3 py-1.5 bg-surface border border-line rounded-full text-ink text-sm font-normal shadow-xs hover:border-btn/40 transition"
        >
          <span>Cart</span>
          <span
            class="flex items-center justify-center w-5 h-5 rounded-full bg-btn text-white text-xs font-medium"
          >
            {cartCount}
          </span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="flex md:hidden items-center justify-center w-9 h-9 rounded-full bg-surface border border-line text-ink hover:bg-blush/30 transition cursor-pointer"
        >
          <svg
            class="w-4.5 h-4.5 stroke-current"
            fill="none"
            viewBox=" 0 0 24 24"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
    <!-- Mobile navigation drawer -->
    <div
      id="mobile-menu"
      class="hidden md:hidden border-t border-line bg-bg px-4 pt-2 pb-4 space-y-1"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="block py-2 text-muted text-base hover:text-ink transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const menuButton =
    document.querySelector<HTMLButtonElement>("#mobile-menu-btn");
  const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");

  menuButton?.addEventListener("click", () => {
    const isOpen = menuButton.getAttribute("aria-expanded") === "true";
    menuButton.setAttribute("aria-expanded", String(!isOpen));
    mobileMenu?.classList.toggle("hidden", isOpen);
  });
</script>
