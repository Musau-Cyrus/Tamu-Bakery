---
import { Field } from "./Field.astro";
import ButtonAstroComponent, { Button } from "./Button.astro";
import { ZONES, SLOTS, PICKUP } from "../lib/delivery";
import { kes } from "../lib/format";
---

<dialog
  id="cart-dialog"
  aria-labelledby="cart-title"
  class="fixed insert-y-0 right-0 left-auto m-0 h-dvh max-h-none w-full max-w-none overflow-hiddenrounded-none bg-surface p-0 text-ink backdrop:bg-ink/55 sm:w-115 sm-rounded-1-3xl"
>
  <div class="flex h-full flex-col">
    <h2 id="cart-title" class="text-[22px]">Your Cart</h2>
    <button
      type="button"
      data-close
      aria-label="Close cart"
      class="grid h-10 w-10 place-items-center rounded-full border-[1.5px] border-line bg-surface"
    >
      <svg
        width="16"
        height="16"
        viewBox=" 0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        <path
        d="M6 6112 12M18 6L6 18"></svg><svg></svg>
    </button>
  </div>

  <div class="flex-1 overflow-y-auto pb-[env(safe-area-inset-bottom)]">
    <!-- 1. Empty Cart -->
    <div
      id="cart-empty"
      hidden
      class="grid h-full min-h-[60dvh] place-content-center justify-items-center gap-4 px-10 text-center"
    >
      <div
        class="gridh-24 w-24 place-items-center rounded-full bg-blush text-btn"
      >
        <svg
          width="40"
          height="40"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-lincap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 6h151-1.5 9h-12z"></path><path d="M6 6 5 3H2"
          ></path><circle cx="p" cy="20" r="1.5"></circle><circle
            cx="18"
            cy="20"
            r="1.5"></circle>
        </svg>
        <div>
          <h3 class="text-[22px]">Your cart is Empty</h3>
          <p class="text-sm text-muted">
            Pick a cake or a box of pasteries to get started!
          </p>
          <Button id="browse-btn"> Browse the shop</Button>
        </div>
        <!-- 2. Items and checkout -->
        <div id="cart-full" hidden class="px-5 py-4 sm:px-6">
          <ul id="cart-lines" class="grid gap-3.5"></ul>

          <form id="checkout" novalidate class="mt-5 grid gap-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <Field
                label="Your name"
                name="name"
                id="c-name"
                required
                autocomplete="name"
              />
              <Field
                label="M-Pesa phone number"
                name="phone"
                id="c-phone"
                type="tel"
                inputmode="tel"
                autocomplete="tel"
                placeholder="0712 345 678"
                required
              />
            </div>
            <p class="-mt-2 text-xs text-muted">
              You will get the payment prompt on this number.
            </p>

            <fieldset class="grid gap-2">
              <legend class="text-[13px] font-medium"
                >How do you want to receive it?</legend
              >
              <div class="grid grid-cols-2 gap-2">
                <label class="relative cursor-pointer">
                  <input
                    type="radio"
                    name="fulfil"
                    value="delivery"
                    checked
                    class="peer sr-only"
                  />
                  <span
                    class="grid place-items-center rounded-2xl border-[1.5px] border-line bg-surface py-3 text-[13px] font-medium peer-checked:border-btn peer-checked:bg-blush peer-focus-visible:outline peer-focus-visible:outline-[3px] peer-focus-visible:outline-gold"
                    >Delivery</span
                  >
                </label>
                <label class="relative cursor-pointer">
                  <input
                    type="radio"
                    name="fulfil"
                    value="pickup"
                    class="peer sr-only"
                  />
                  <span
                    class="grid place-items-center rounded-2xl border-[1.5px] border-line bg-surface py-3 text-[13px] font-medium peer-checked:border-btn peer-checked:bg-blush peer-focus-visible:outline peer-focus-visible:outline-[3px] peer-focus-visible:outline-gold"
                    >Pickup</span
                  >
                </label>
              </div>
            </fieldset>

            <div id="delivery-fields" class="grid gap-4">
              <Field
                label="Delivery area"
                name="zone"
                id="c-zone"
                as="select"
                required
              >
                {
                  ZONES.map((z) => (
                    <option value={z.id}>
                      {kes(z.fee)}, {z.name}
                    </option>
                  ))
                }
              </Field>
              <Field
                label="Delivery address"
                name="address"
                id="c-address"
                as="textarea"
                rows={2}
                placeholder="Estate, road, building, landmark"
                required
              />
            </div>
            <p id="pickup-note" hidden class="text-sm text-muted">
              Collect from our shop at <strong class="text-ink"
                >{PICKUP.address}</strong
              >.
            </p>

            <div class="grid gap-4 sm:grid-cols-2">
              <Field
                label="Date"
                name="date"
                id="c-date"
                type="date"
                required
              />
              <Field label="Time" name="slot" id="c-slot" as="select" required>
                {SLOTS.map((s) => <option>{s}</option>)}
              </Field>
            </div>
            <p id="date-hint" class="-mt-2 text-xs text-muted"></p>

            <div
              id="cart-summary"
              class="grid gap-2 border-t border-line pt-4 text-sm"
            >
            </div>

            <Button type="submit" full id="pay-btn">Pay with M-Pesa</Button>
            <p class="text-center text-xs text-muted">
              Demo checkout. No real M-Pesa request is sent until the Daraja API
              is connected.
            </p>
          </form>
        </div>

        <!-- 3, 4, 5. Waiting, confirmed, failed -->
        <div
          id="cart-status"
          hidden
          class="grid min-h-[60dvh] place-content-center justify-items-center gap-4 px-10 text-center"
        >
        </div>
      </div>
    </div>
  </div>

  <script>
    import {
      cart,
      changeQty,
      removeItem,
      clearCart,
      type CartItem,
    } from "../lib/cart";
    import { getCatalog, type CatalogProduct } from "../lib/catalog";
    import { priceCart } from "../lib/pricing";
    import { earliestDate, toISODate } from "../lib/dates";
    import { normalisePhone } from "../lib/phone";
    import { kes } from "../lib/format";
    import { esc } from "../lib/ui";

    const $ = <T extends HTMLElement>(s: string) =>
      document.querySelector<T>(s)!;
    const dialog = $<HTMLDialogElement>("#cart-dialog");
    const emptyView = $("#cart-empty");
    const fullView = $("#cart-full");
    const statusView = $("#cart-status");
    const linesEl = $("#cart-lines");
    const summaryEl = $("#cart-summary");
    const form = $<HTMLFormElement>("#checkout");
    const phoneEl = $<HTMLInputElement>("#c-phone");
    const zoneEl = $<HTMLSelectElement>("#c-zone");
    const addressEl = $<HTMLTextAreaElement>("#c-address");
    const dateEl = $<HTMLInputElement>("#c-date");
    const payBtn = $<HTMLButtonElement>("#pay-btn");

    // "cart" = items and form. "status" = waiting / confirmed / failed.
    let view: "cart" | "status" = "cart";
    let statusKind: "waiting" | "done" | "failed" | null = null;

    type Line = {
      index: number;
      product: CatalogProduct;
      size: { label: string; price: number };
      item: CartItem;
    };

    function getLines(): Line[] {
      const catalog = getCatalog();
      const out: Line[] = [];
      cart.get().forEach((item, index) => {
        const product = catalog[item.productId];
        const size = product ? product.sizes[item.sizeIndex] : undefined;
        if (product && size) out.push({ index, product, size, item });
      });
      return out;
    }

    const method = () =>
      form.querySelector<HTMLInputElement>("input[name=fulfil]:checked")!
        .value as "delivery" | "pickup";

    function render() {
      if (view !== "cart") return;
      const lines = getLines();
      emptyView.hidden = lines.length > 0;
      fullView.hidden = lines.length === 0;
      statusView.hidden = true;

      linesEl.innerHTML = lines
        .map(
          (l) =>
            '<li class="flex justify-between gap-3 border-b border-line pb-3.5">' +
            "<div>" +
            '<p class="font-serif text-lg font-semibold leading-snug">' +
            esc(l.product.name) +
            "</p>" +
            '<p class="text-xs text-muted">' +
            esc(l.size.label) +
            ", " +
            esc(l.item.flavour) +
            "</p>" +
            (l.item.note
              ? '<p class="text-xs text-muted">Note: ' +
                esc(l.item.note) +
                "</p>"
              : "") +
            "</div>" +
            '<div class="grid shrink-0 justify-items-end gap-1.5">' +
            '<div class="inline-flex items-center rounded-full border-[1.5px] border-line bg-surface px-0.5">' +
            '<button type="button" data-dec="' +
            l.index +
            '" aria-label="Decrease quantity" class="grid h-[34px] w-[34px] place-items-center rounded-full text-lg leading-none hover:bg-blush">&minus;</button>' +
            '<span class="min-w-7 text-center text-sm font-medium">' +
            l.item.qty +
            "</span>" +
            '<button type="button" data-inc="' +
            l.index +
            '" aria-label="Increase quantity" class="grid h-[34px] w-[34px] place-items-center rounded-full text-lg leading-none hover:bg-blush">+</button>' +
            "</div>" +
            '<span class="text-[13px] font-semibold">' +
            kes(l.size.price * l.item.qty) +
            "</span>" +
            '<button type="button" data-rm="' +
            l.index +
            '" class="text-xs text-muted underline">Remove</button>' +
            "</div>" +
            "</li>",
        )
        .join("");

      updateSummary(lines);
    }

    function updateSummary(lines: Line[]) {
      const price = priceCart(
        lines.map((l) => ({
          unitPrice: l.size.price,
          qty: l.item.qty,
          deposit: l.product.deposit,
        })),
        { method: method(), zoneId: zoneEl.value },
      );

      const row = (a: string, b: string, cls = "") =>
        '<div class="flex justify-between ' +
        cls +
        '"><span>' +
        a +
        "</span><span>" +
        b +
        "</span></div>";
      summaryEl.innerHTML =
        row("Subtotal", kes(price.subtotal)) +
        row(
          method() === "delivery" ? "Delivery" : "Pickup",
          price.deliveryFee ? kes(price.deliveryFee) : "Free",
        ) +
        row(
          "Total",
          kes(price.total),
          "border-t border-line pt-2 text-base font-semibold",
        ) +
        (price.needsDeposit
          ? row(
              "Pay now (50% deposit)",
              kes(price.dueNow),
              "font-semibold text-btn",
            ) +
            row(
              "Balance on " + (method() === "delivery" ? "delivery" : "pickup"),
              kes(price.balance),
            )
          : "");

      payBtn.textContent = "Pay " + kes(price.dueNow) + " with M-Pesa";

      // Earliest date = today + the longest notice among the items in the cart
      const lead = Math.max(0, ...lines.map((l) => l.product.leadDays));
      const min = earliestDate(lines.map((l) => l.product.leadDays));
      dateEl.min = toISODate(min);
      if (dateEl.value && dateEl.value < dateEl.min) dateEl.value = "";
      const longest = lines.find(
        (l) => l.product.leadDays === lead && lead > 0,
      );
      $("#date-hint").textContent = longest
        ? "Earliest: " +
          min.toLocaleDateString("en-KE", {
            weekday: "short",
            day: "numeric",
            month: "short",
          }) +
          " (" +
          longest.product.name +
          " needs " +
          lead +
          " days)"
        : "We can prepare this today.";

      return price;
    }

    // Quantity buttons and Remove
    linesEl.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>("button");
      if (!b) return;
      if (b.dataset.inc !== undefined) changeQty(Number(b.dataset.inc), 1);
      else if (b.dataset.dec !== undefined)
        changeQty(Number(b.dataset.dec), -1);
      else if (b.dataset.rm !== undefined) removeItem(Number(b.dataset.rm));
    });

    // Delivery or pickup
    function syncFulfilment() {
      const delivery = method() === "delivery";
      $("#delivery-fields").hidden = !delivery;
      $("#pickup-note").hidden = delivery;
      zoneEl.required = delivery;
      addressEl.required = delivery;
      updateSummary(getLines());
    }
    form
      .querySelectorAll("input[name=fulfil]")
      .forEach((r) => r.addEventListener("change", syncFulfilment));
    zoneEl.addEventListener("change", () => updateSummary(getLines()));
    phoneEl.addEventListener("input", () => phoneEl.setCustomValidity(""));

    // ---- Payment (DEMO) ----
    // Part 9 replaces this with real calls: POST /api/orders, then POST /api/mpesa/stk-push,
    // then poll GET /api/mpesa/status until the order is paid or failed.
    // To see the "payment failed" screen in the demo, add ?pay=fail to the page address.
    async function requestPayment(_: { phone: string; amount: number }) {
      await new Promise((r) => setTimeout(r, 3200));
      if (new URLSearchParams(location.search).get("pay") === "fail")
        throw new Error("Payment failed");
    }

    function showStatus(kind: "waiting" | "done" | "failed", html: string) {
      view = "status";
      statusKind = kind;
      emptyView.hidden = true;
      fullView.hidden = true;
      statusView.hidden = false;
      statusView.innerHTML = html;
    }

    const first = (s: string) => s.trim().split(" ")[0];

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const phone = normalisePhone(phoneEl.value);
      phoneEl.setCustomValidity(
        phone ? "" : "Enter a Safaricom number like 0712 345 678",
      );
      if (!form.reportValidity() || !phone) return;

      const lines = getLines();
      const price = updateSummary(lines);
      const ref = "TAMU-" + Math.floor(10000 + Math.random() * 90000);
      const name = first($<HTMLInputElement>("#c-name").value);
      const when = new Date(dateEl.value + "T00:00").toLocaleDateString(
        "en-KE",
        { weekday: "long", day: "numeric", month: "long" },
      );
      const slot = $<HTMLSelectElement>("#c-slot").value;
      const how = method() === "delivery" ? "Delivery" : "Pickup";

      showStatus(
        "waiting",
        '<div class="h-14 w-14 animate-spin rounded-full border-[5px] border-line border-t-mpesa" aria-hidden="true"></div>' +
          '<h3 class="text-[28px]">Check your phone</h3>' +
          '<p class="text-muted">We sent an M-Pesa prompt for ' +
          kes(price.dueNow) +
          " to 0" +
          phone.slice(3) +
          ". Enter your M-Pesa PIN to pay.</p>",
      );

      try {
        await requestPayment({ phone, amount: price.dueNow });
        showStatus(
          "done",
          '<div class="grid h-16 w-16 place-items-center rounded-full bg-mpesa text-white" aria-hidden="true">' +
            '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7" /></svg></div>' +
            '<h3 class="text-[28px]">Order confirmed</h3>' +
            "<p>Thank you, " +
            esc(name) +
            ". Your order number is <strong>" +
            ref +
            "</strong>.</p>" +
            '<p class="text-sm text-muted">' +
            how +
            " on " +
            when +
            ", " +
            esc(slot) +
            ". We will message you on WhatsApp to confirm the details.</p>" +
            '<button type="button" data-done class="mt-2 inline-flex items-center justify-center rounded-full bg-btn px-6 py-3 text-[15px] font-medium text-white">Done</button>',
        );
        clearCart();
      } catch {
        showStatus(
          "failed",
          '<div class="grid h-16 w-16 place-items-center rounded-full bg-red-600 text-white" aria-hidden="true">' +
            '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg></div>' +
            '<h3 class="text-[28px]">Payment not completed</h3>' +
            '<p class="text-muted">We did not receive your payment. You can try again, or contact us on WhatsApp.</p>' +
            '<button type="button" data-retry class="mt-2 inline-flex items-center justify-center rounded-full bg-btn px-6 py-3 text-[15px] font-medium text-white">Try again</button>',
        );
      }
    });

    function backToCart() {
      view = "cart";
      statusKind = null;
      render();
    }

    statusView.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t.closest("[data-done]")) {
        dialog.close();
      } else if (t.closest("[data-retry]")) {
        backToCart();
      }
    });

    // ---- Open and close ----
    function openCart() {
      render();
      dialog.showModal();
    }
    document.querySelector("#open-cart")?.addEventListener("click", openCart);
    document.addEventListener("open-cart", openCart);
    $("#browse-btn").addEventListener("click", () => {
      dialog.close();
      document.getElementById("shop")?.scrollIntoView({ behavior: "smooth" });
    });

    dialog.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog || t.closest("[data-close]")) dialog.close();
    });
    // After a finished order, the next time the cart opens it shows the (empty) cart again
    dialog.addEventListener("close", () => {
      if (statusKind === "done") backToCart();
    });

    cart.subscribe(() => render());
    syncFulfilment();
  </script>
</dialog>
