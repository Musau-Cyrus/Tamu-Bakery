---
import { Image } from "astro:assets";
import ArchPanel from "./ArchPanel.astro";
import Button from "./Button.astro";
import type { Product } from "../lib/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const p = product.data;
const href = "/product/" + product.id;

const from = Math.min(...p.sizes.map((size) => size.price));
const kes = (n: number) => "KES " + n.toLocaleString("en-KE");

const lead =
  p.leadDays === 0
    ? "Ready the same day"
    : "Order " + p.leadDays + " day" + (p.leadDays > 1 ? "s" : "") + " ahead";

const tints = {
  birthday: "pink",
  bridal: "pink",
  cupcakes: "peach",
  pastries: "butter",
  bread: "cream",
} as const;
---

<article
  class="flex flex-col gap-3"
  data-product-card={product.id}
  data-category={p.category}
>
  <a href={href} class="block" aria-label={"Choose options for " + p.name}>
    <ArchPanel tint={tints[p.category]}>
      <Image
        src={p.image}
        alt={p.name}
        width={640}
        height={480}
        widths={[320, 480, 640]}
        sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
        class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
      />
      {
        p.soldOut && (
          <span class="absolute bottom-3 left-1/2 -translate-x-1/2 rounded-full bg-ink/85 px-3 py-1 text-xs font-medium text-white">
            Sold out
          </span>
        )
      }
    </ArchPanel>
  </a>

  <div>
    <h3 class="font-serif text-lg font-semibold leading-snug sm:text-[22px]">
      {p.name}
    </h3>
    <!-- The short description is hidden on phones to keep the two-column cards compact -->
    <p class="mt-1 hidden text-sm text-muted sm:block">{p.description}</p>
    <p class="mt-1 text-xs text-muted">{lead}</p>
  </div>

  <div
    class="mt-auto flex flex-col gap-2 pt-1 sm:flex-row sm:items-center sm:justify-between"
  >
    <span class="text-sm font-semibold sm:text-base">From {kes(from)}</span>
    {
      p.soldOut ? (
        <span class="text-sm text-muted">Sold out</span>
      ) : (
        <Button
          size="sm"
          class="h-10 w-full whitespace-nowrap sm:w-auto sm:min-w-33"
          data-open-product={product.id}
        >
          Choose options
        </Button>
      )
    }
  </div>
</article>
