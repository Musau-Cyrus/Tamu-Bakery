---
interface Props {
  tint?: "pink" | "choc" | "peach" | "butter" | "cream" | "blush";
  class?: string;
}

const { tint = "pink", class: extra } = Astro.props;

// Full class names, so Tailwind can find them
const tints = {
  pink: "bg-tint-pink",
  choc: "bg-tint-choc",
  peach: "bg-tint-peach",
  butter: "bg-tint-butter",
  cream: "bg-tint-cream",
  blush: "bg-blush",
};

const classes = [
  "relative aspect-[1/1.12] border-2 border-btn bg-surface p-1.5",
  tints[tint],
  extra,
];
---

<div
  class:list={classes}
  style="border-radius: 50% 50% 5px 5px / 40% 40% 5px 5px;"
>
  <div
    class="relative flex h-full w-full items-end justify-center overflow-hidden"
    style="border-radius: 50% 50% 2px 2px / 40% 40% 2px 2px;"
  >
    <slot />
  </div>
</div>
