---
interface Props {
  tint?: "pink" | "choc" | "peach" | "butter" | "cream" | "blush";
  class?: string;
}
 
const { tint = "pink", class: extra } = Astro.props;
 
// Full class names, so Tailwind can find them
const tints = {
  pink: "bg-tint-pink",
  choc: "bg-tint-choc",
  peach: "bg-tint-peach",
  butter: "bg-tint-butter",
  cream: "bg-tint-cream",
  blush: "bg-blush",
};
 
// The box is slightly taller than wide (1 : 1.12). The top corners are 50% across and 45% down,
// which gives a true half-circle on that shape. The bottom corners are a fixed 18px.
const classes = [
  "relative flex aspect-[1/1.12] items-end justify-center overflow-hidden rounded-t-[50%/45%] rounded-b-[18px]",
  tints[tint],
  extra,
];
---
 
<div class:list={classes}>
  <slot />
</div>