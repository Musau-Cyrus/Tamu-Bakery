---
// src/components/ShopList.astro
// Filter chips plus the grid of product cards.
//
// Usage:
//   <ShopList products={items} active="birthday" />   // birthday filter selected
//   <ShopList products={all} />                       // all products shown

import Chip from "./Chip.astro";
import ProductCard from "./ProductCard.astro";
import { CATEGORIES, type Product } from "../lib/products";

interface Props {
  products: Product[];
  active?: string;
  title?: string;
  headingLevel?: "h1" | "h2";
  headingId?: string;
}

const { products, active, title, headingLevel = "h2", headingId } = Astro.props;
const Heading = headingLevel === "h1" ? "h1" : "h2";
---

<div data-shop-list data-active-category={active ?? "all"}>
  <div
    class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between"
  >
    {
      title && (
        <Heading id={headingId} class="text-[30px] lg:text-[40px]">
          {title}
        </Heading>
      )
    }
    <div
      class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 lg:mx-0 lg:ml-auto lg:px-0"
      role="navigation"
      aria-label="Categories"
    >
      <Chip data-category-filter="all" selected={!active}>All</Chip>
      {
        CATEGORIES.map((c) => (
          <Chip data-category-filter={c.id} selected={active === c.id}>
            {c.short}
          </Chip>
        ))
      }
    </div>
  </div>

  {
    products.length > 0 ? (
      <div
        data-product-grid
        class="mt-8 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-3 lg:grid-cols-4 lg:gap-x-6"
      >
        {products.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    ) : (
      <p class="mt-10 text-muted">Nothing here yet. Please check back soon.</p>
    )
  }
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-shop-list]")
    .forEach((shopList) => {
      const filters = shopList.querySelectorAll<HTMLButtonElement>(
        "[data-category-filter]",
      );
      const cards = shopList.querySelectorAll<HTMLElement>(
        "[data-product-card]",
      );

      const applyFilter = (category: string) => {
        filters.forEach((filter) => {
          const selected = filter.dataset.categoryFilter === category;
          filter.setAttribute("aria-pressed", String(selected));
          filter.classList.toggle("border-btn", selected);
          filter.classList.toggle("bg-btn", selected);
          filter.classList.toggle("text-white", selected);
          filter.classList.toggle("border-rose", !selected);
          filter.classList.toggle("bg-surface", !selected);
          filter.classList.toggle("text-ink", !selected);
        });

        cards.forEach((card) => {
          const show = category === "all" || card.dataset.category === category;
          card.hidden = !show;
        });

        shopList.dataset.activeCategory = category;
      };

      filters.forEach((filter) => {
        filter.addEventListener("click", () => {
          applyFilter(filter.dataset.categoryFilter ?? "all");
        });
      });

      applyFilter(shopList.dataset.activeCategory ?? "all");
    });
</script>
