---
// One page per product. The page itself is static; the small script at the bottom
// handles the size, quantity and "Add to cart" button in the browser.

import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchPanel from "../../components/ArchPanel.astro";
import Button from "../../components/Button.astro";
import Field from "../../components/Field.astro";
import Quantity from "../../components/Quantity.astro";
import { CATEGORIES, tintFor, type Product } from "../../lib/products";
import { kes, leadText } from "../../lib/format";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { slug: product.id }, // the file name without .json
    props: { product },
  }));
}

const { product } = Astro.props as { product: Product };
const p = product.data;
const category = CATEGORIES.find((c) => c.id === p.category)!;
const prices = p.sizes.map((s) => s.price);
---

<BaseLayout title={p.name + " | Tamu Bakery"} description={p.description}>
  <div
    class="mx-auto grid max-w-290 gap-10 px-4 py-8 lg:grid-cols-2 lg:gap-16 lg:px-10 lg:py-14"
  >
    <!-- Picture -->
    <div>
      <a
        href={"/shop/" + category.id}
        class="text-sm text-muted hover:text-ink hover:underline"
      >
        &larr; {category.label}
      </a>
      <ArchPanel
        tint={tintFor(p.category)}
        class="mx-auto mt-4 max-w-md lg:max-w-none"
      >
        <Image
          src={p.image}
          alt={p.name}
          width={736}
          height={1308}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 540px, 90vw"
          loading="eager"
          class="h-full w-full object-cover"
        />
      </ArchPanel>
    </div>

    <!-- Details and options -->
    <div class="lg:pt-8">
      <h1 class="text-[34px] lg:text-[44px]">{p.name}</h1>
      <p class="mt-3 text-muted">{p.description}</p>

      <div
        id="product-form"
        data-product-id={product.id}
        data-prices={JSON.stringify(prices)}
        class="mt-8 grid gap-5"
      >
        <!-- Size -->
        <fieldset class="grid gap-2">
          <legend class="text-[13px] font-medium">Size</legend>
          <div class="flex flex-wrap gap-2">
            {
              p.sizes.map((s, i) => (
                <label class="relative cursor-pointer">
                  <input
                    type="radio"
                    name="size"
                    value={i}
                    checked={i === 0}
                    class="peer sr-only"
                  />
                  <span class="grid rounded-2xl border-[1.5px] border-line bg-surface px-4 py-2 text-xs leading-snug peer-checked:border-btn peer-checked:bg-tint-pink peer-focus-visible:outline-[3px] peer-focus-visible:outline-gold">
                    {s.label}
                    <b class="text-[13px] font-semibold text-btn">
                      {kes(s.price)}
                    </b>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <!-- Flavour -->
        <Field label="Flavour" name="flavour" id="flavour" as="select">
          {p.flavours.map((f) => <option value={f}>{f}</option>)}
        </Field>

        <!-- Note on the cake (only for products that have one) -->
        {
          p.note && (
            <Field
              label={p.note.label}
              name="note"
              id="note"
              maxlength={p.note.maxLength}
              placeholder={p.note.placeholder}
            />
          )
        }

        <p class="text-sm text-muted">
          {leadText(p.leadDays)}.
          {p.deposit && " A 50% deposit secures your date."}
        </p>

        <!-- Quantity and add to cart -->
        <div class="flex items-center gap-4">
          <Quantity name="qty" />
          <Button id="add-to-cart" full disabled={p.soldOut}>
            {p.soldOut ? "Sold out" : "Add to cart"}
            {!p.soldOut && <span id="add-total" class="ml-1.5" />}
          </Button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { addItem } from "../../lib/cart";

  const root = document.querySelector<HTMLElement>("#product-form");

  if (root) {
    const productId = root.dataset.productId!;
    const prices: number[] = JSON.parse(root.dataset.prices!);
    const flavour = root.querySelector<HTMLSelectElement>("#flavour")!;
    const note = root.querySelector<HTMLInputElement>("#note");
    const total = root.querySelector<HTMLElement>("#add-total");
    const addButton = root.querySelector<HTMLButtonElement>("#add-to-cart")!;
    let qty = 1;

    const kes = (n: number) => "KES " + n.toLocaleString("en-KE");
    const sizeIndex = () =>
      Number(
        root.querySelector<HTMLInputElement>("input[name=size]:checked")!.value,
      );

    // Show the live price on the button: "Add to cart (KES 6,500)"
    const update = () => {
      if (total) total.textContent = "(" + kes(prices[sizeIndex()] * qty) + ")";
    };

    root.addEventListener("change", (e) => {
      if ((e.target as HTMLInputElement).name === "size") update();
    });
    // Quantity.astro announces changes with this event
    root.addEventListener("quantity-change", (e) => {
      qty = (e as CustomEvent<{ value: number }>).detail.value;
      update();
    });

    addButton.addEventListener("click", () => {
      addItem({
        productId,
        sizeIndex: sizeIndex(),
        flavour: flavour.value,
        note: note ? note.value.trim() : "",
        qty,
      });
      // Open the cart drawer (the header's cart button opens it)
      document.querySelector<HTMLButtonElement>("#open-cart")?.click();
    });

    update();
  }
</script>
