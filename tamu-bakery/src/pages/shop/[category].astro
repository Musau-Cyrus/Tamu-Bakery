---
// src/pages/shop/[category].astro  ->  /shop/birthday, /shop/bridal, ...
// Astro builds one page for every category listed in getStaticPaths.

import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShopList from "../../components/ShopList.astro";
import { CATEGORIES } from "../../lib/products";

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({
    params: { category: c.id },
    props: { label: c.label },
  }));
}

const { category } = Astro.params;
const { label } = Astro.props;

const products = (await getCollection("products")).filter((p) => p.data.category === category);
---

<BaseLayout title={label + " | Tamu Bakery"} description={"Order " + label.toLowerCase() + " online and pay with M-Pesa."}>
  <div class="mx-auto max-w-[1160px] px-4 py-10 lg:px-10 lg:py-16">
    <h1 class="text-[34px] lg:text-[48px]">{label}</h1>
    <div class="mt-6"><ShopList products={products} active={category} /></div>
  </div>
</BaseLayout>